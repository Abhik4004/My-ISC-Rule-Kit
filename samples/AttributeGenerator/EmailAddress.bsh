// Attribute Generator rule: email address  firstname.lastname@<domain>
//
// - Uses the identity attribute preferredFirstName when it is set.
// - The domain comes from the source's "emailDomain" setting (example.org when missing).
// - When another identity already has the address, tries lastname2, lastname3 ... up to 50.

String domain = application.getStringAttributeValue("emailDomain");
if (domain == null || domain.trim().isEmpty()) domain = "example.org";

String preferred = (String) identity.getAttribute("preferredFirstName");
String first = (preferred != null && !preferred.trim().isEmpty()) ? preferred : identity.getFirstname();
String last = identity.getLastname();
if (first == null || last == null) {
    log.warn("Cannot build an email for " + identity.getName() + ": missing name");
    return null;
}

String local = (first.trim() + "." + last.trim()).toLowerCase().replaceAll("[^a-z.]", "");
String email = local + "@" + domain;
int n = 1;
while (idn.countIdentitiesBySearchableIdentityAttribute("email", "Equals", email) > 0) {
    n++;
    if (n > 50) throw new Exception("Could not find a free email address for " + identity.getName());
    email = local + n + "@" + domain;
}
return email;
