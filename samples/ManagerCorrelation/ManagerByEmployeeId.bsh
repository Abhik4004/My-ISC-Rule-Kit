// Manager Correlation rule: the HR feed sends the manager as "LASTNAME, First (000123)" or just "000123".
// Pull out the digits inside the parentheses (or the whole value), strip leading zeros,
// and correlate the manager on employeeNumber.
import java.util.HashMap;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

Map returnMap = new HashMap();
if (managerAttributeValue == null) return returnMap;

String raw = managerAttributeValue.toString().trim();
String id = null;
Matcher m = Pattern.compile("\\((\\d+)\\)\\s*$").matcher(raw);
if (m.find()) id = m.group(1);
else if (raw.matches("\\d+")) id = raw;

if (id == null) {
    log.warn("Unrecognised manager value '" + raw + "' on " + link.getNativeIdentity());
    return returnMap;
}
id = id.replaceFirst("^0+(?!$)", "");
returnMap.put("identityAttributeName", "employeeNumber");
returnMap.put("identityAttributeValue", id);
return returnMap;
