// BuildMap rule for a delimited HR file.
//
// - Pairs each column name with its value, trimming whitespace; empty values become null.
// - Adds displayName "First Last" (preferred first name when present).
// - Turns MM/dd/yyyy dates in hireDate / termDate into yyyy-MM-dd.
// - Splits the pipe-separated "roles" column into a list.
import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public String isoDate(String us) {
    if (us == null) return null;
    String[] p = us.split("/");
    if (p.length != 3) return us;
    return p[2] + "-" + (p[0].length() == 1 ? "0" + p[0] : p[0]) + "-" + (p[1].length() == 1 ? "0" + p[1] : p[1]);
}

Map map = new HashMap();
for (int i = 0; i < cols.size(); i++) {
    String value = i < record.size() ? (String) record.get(i) : null;
    if (value != null) value = value.trim();
    map.put(cols.get(i), value == null || value.isEmpty() ? null : value);
}

String first = map.get("preferredName") != null ? (String) map.get("preferredName") : (String) map.get("firstName");
String last = (String) map.get("lastName");
if (first != null && last != null) map.put("displayName", first + " " + last);

map.put("hireDate", isoDate((String) map.get("hireDate")));
map.put("termDate", isoDate((String) map.get("termDate")));

String roles = (String) map.get("roles");
map.put("roles", roles == null ? new ArrayList() : new ArrayList(Arrays.asList(roles.split("\\s*\\|\\s*"))));
return map;
