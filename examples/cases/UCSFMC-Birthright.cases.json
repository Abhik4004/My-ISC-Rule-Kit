{
  "cases": [
    {
      "name": "01 Add Birthright, active staff -> Enable + Regular Users OU",
      "inputs": {
        "plan": {
          "identity": { "id": "2c9180", "name": "jdoe", "attributes": { "cloudLifecycleState": "active", "identificationNumber": "12345", "affiliation": "staff", "primaryUserAffiliation": "staff", "90DaysPostInactive": "false", "hasMailbox": "true", "requiresMailboxOn": "true" } },
          "accountRequests": [ { "applicationName": "Medical Center Active Directory", "nativeIdentity": "CN=jdoe,OU=MedCenterUsers,DC=ql1,DC=ucsfmedicalcenter,DC=org", "operation": "Modify",
            "attributeRequests": [ { "name": "memberOf", "operation": "Add", "value": "CN=DualAuthUsersMedCtr,OU=Application Accounts,OU=MedCenterUsers,DC=ql1,DC=ucsfmedicalcenter,DC=org" } ] } ]
        },
        "application": { "name": "Medical Center Active Directory", "attributes": { "environment": "Sandbox" } },
        "integration": null,
        "idn": { "accountExistsByNativeIdentity": true,
                 "getRawAccountAttribute": { "$byLastArg": { "emergencyDisabled": "false", "brb": "false", "msExchRecipientTypeDetails": "1", "sAMAccountName": "jdoe", "userPrincipalName": "jdoe@ucsf.edu", "description": "Staff - Radiology" }, "$default": "" } }
      },
      "expectChanged": { "plan": { "accountRequests": [ { "operation": "Enable",
        "attributeRequests": [ { "name": "memberOf", "operation": "Add" },
                               { "name": "AC_NewParent", "operation": "Set", "value": "OU=MedCenterUsers,DC=ql1,DC=ucsfmedicalcenter,DC=org" } ],
        "arguments": { "isBrb": "false", "isEmergencyDisabled": "false", "primaryAffiliation": "staff", "is90daysPostInactive": "false", "sAMAccountName": "jdoe" } } ] } },
      "expectLogContains": [ "Birthright group is being added", "moved to regular users OU" ]
    },
    {
